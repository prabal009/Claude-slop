{
  "name": "printq-shopkeeper",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently --kill-others-on-fail \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "build:server": "esbuild server/index.ts --bundle --platform=node --target=node22 --format=esm --packages=external --outfile=dist-server/index.js",
    "build": "npm run typecheck && vite build && npm run build:server",
    "start": "node dist-server/index.js --production",
    "preview": "node dist-server/index.js --production --port=4173",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "invite:shopkeeper": "tsx scripts/create-shopkeeper-invite.ts",
    "context:export": "tsx scripts/export-context.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@toon-format/toon": "^4.4.0",
    "@zxing/browser": "^0.1.5",
    "cookie": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "gpt-tokenizer": "^4.1.2",
    "gsap": "^3.13.0",
    "lucide-react": "^0.577.0",
    "pg": "^8.16.3",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^3.4.1",
    "set-cookie-parser": "^2.7.1",
    "three": "^0.181.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/cookie": "^1.0.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.181.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^27.2.0",
    "supertest": "^7.3.2",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.9"
  }
}
